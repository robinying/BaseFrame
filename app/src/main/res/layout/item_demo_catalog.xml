<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_4"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/colorSurface"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:strokeColor="@color/colorOutline"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/demo_card_min_height"
        android:paddingStart="@dimen/space_12"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/space_8"
        android:paddingBottom="@dimen/space_12">

        <ImageView
            android:id="@+id/demo_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:padding="@dimen/space_8"
            android:src="@drawable/ic_demo_overlay"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/demo_title"
            style="@style/TextAppearance.BaseFrame.CardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_marginEnd="@dimen/space_8"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/colorOnSurface"
            app:layout_constraintEnd_toStartOf="@id/demo_arrow"
            app:layout_constraintStart_toEndOf="@id/demo_icon"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/demo_summary"
            style="@style/TextAppearance.BaseFrame.CardSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginEnd="@dimen/space_8"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/colorOnSurfaceVariant"
            app:layout_constraintEnd_toStartOf="@id/demo_arrow"
            app:layout_constraintStart_toEndOf="@id/demo_icon"
            app:layout_constraintTop_toBottomOf="@id/demo_title" />

        <TextView
            android:id="@+id/demo_unavailable_badge"
            style="@style/TextAppearance.BaseFrame.CardSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:background="@drawable/bg_demo_unavailable_badge"
            android:paddingStart="@dimen/space_8"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/space_8"
            android:paddingBottom="@dimen/space_4"
            android:text="@string/demo_unavailable_badge"
            android:textColor="@color/colorOnSurfaceVariant"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/demo_icon"
            app:layout_constraintTop_toBottomOf="@id/demo_summary" />

        <ImageView
            android:id="@+id/demo_arrow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_chevron_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
